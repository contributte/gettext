{
  "name": "f00b4r/php-gettext",
  "type": "library",
  "description": "Fixed php-gettext for PHP 5.6 - 8.0",
  "keywords": ["gettext", "php"],
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/f00b4r/php-gettext",
  "authors": [
    {
      "name": "Milan Felix Šulc",
      "homepage": "https://f3l1x.io"
    }
  ],
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "contributte/phpstan": "^0.1.0",
    "contributte/qa": "^0.4.0",
    "contributte/tester": "^0.3.0"
  },
  "autoload": {
    "classmap": ["src/"]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    },
    "files": [
      "examples/bootstrap.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "branch-alias": {
      "dev-master": "1.1.x-dev"
    }
  }
}
